{
  "schema_version": 1,
  "id": "starter-template",
  "name": "Starter",
  "version": "0.1.0",
  "author": "Blue Lodge Builder",
  "license": "MIT",
  "category": "template",
  "tagline": "Sovereign Blue Lodge starter module — standalone SQLite app + agent tools + ALP v1 FIFO/ReAct loop + XSS-safe Web UI.",
  "hardware_badges": ["no-special-hardware", "offline-capable", "zero-keys-required"],
  "requires_core": ">=2026.11",
  "runtime": {
    "venv_mode": "shared_locked",
    "python_packages": []
  },
  "provides": {
    "tools_schema": "tools/schemas.json",
    "tools_dispatcher": "tools/dispatch.sh",
    "tool_bundle": "+starter",
    "core_tools": ["file_read", "file_write", "web_search"],
    "workflows_dir": "workflows",
    "domain_keywords": "starter-template starter starter notes briefing",
    "context_hook": "hooks/context.sh",
    "strategist_hook": "hooks/strategist.txt",
    "event_reactors": ["reactors/sample_reactors.json"],
    "ui": {
      "js": "ui/panel.js",
      "css": "ui/panel.css"
    }
  },
  "permissions": {
    "tier": "A",
    "network_egress": [],
    "filesystem_rw": [".george/module_data/starter-template"],
    "privileged_docker": false,
    "secrets_required": []
  },
  "healthcheck": "hooks/health.sh"
}
